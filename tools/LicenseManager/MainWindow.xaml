<Window x:Class="LicenseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACP License Manager — Blank RL"
        Width="960" Height="640" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Grid Grid.Row="0" Margin="2,0,2,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="License Manager" Style="{StaticResource HeaderText}" VerticalAlignment="Center" />
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6"
                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PRIVATE TOOL" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Manage activation keys for Advanced Controller Processor"
                           FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="1,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RefreshBtn" Content="Refresh" Style="{StaticResource SecondaryButton}"
                        Click="OnRefreshClick" IsEnabled="False" />
                <Button x:Name="CreateBtn" Content="+ Create Key" Style="{StaticResource PrimaryButton}"
                        Click="OnShowCreateClick" Margin="8,0,0,0" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- ═══ Connect panel (shown until configured) ═══ -->
        <Border x:Name="ConnectPanel" Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="18" Margin="2,0,2,10">
            <StackPanel MaxWidth="560">
                <TextBlock Text="Connect to your Supabase project" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="Paste the Project URL and the SECRET key (Settings → API). The secret stays on this PC only."
                           FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12" />

                <TextBlock Text="PROJECT URL" Style="{StaticResource LabelStyle}" Margin="0,0,0,4" />
                <TextBox x:Name="UrlInput" Style="{StaticResource InputBox}" Margin="0,0,0,10" />

                <TextBlock Text="SECRET KEY (sb_secret_…)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4" />
                <PasswordBox x:Name="SecretInput" Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1" Padding="8,7" FontSize="13" CaretBrush="#8B5CF6" Margin="0,0,0,12" />

                <Button Content="Save &amp; Connect" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Padding="22,9" Click="OnConnectClick" />
            </StackPanel>
        </Border>

        <!-- ═══ Create-key overlay ═══ -->
        <Border x:Name="CreateOverlay" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="100"
                Background="#CC0B0E17"
                CornerRadius="12" Padding="24" Visibility="Collapsed">
            <StackPanel MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Step 1: label input -->
                <StackPanel x:Name="CreateFormStep">
                    <TextBlock Text="Create a new key" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="Optional label so you remember who the key belongs to."
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="LABEL (optional)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4" />
                    <TextBox x:Name="LabelInput" Style="{StaticResource InputBox}" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Generate &amp; Save" Style="{StaticResource PrimaryButton}"
                                Padding="20,9" Click="OnGenerateClick" />
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Click="OnCloseOverlayClick" />
                    </StackPanel>
                </StackPanel>

                <!-- Step 2: show plaintext key ONCE -->
                <StackPanel x:Name="CreateResultStep" Visibility="Collapsed">
                    <TextBlock Text="🔑 Key created — copy it NOW" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="This is the only time the full key is shown. It cannot be recovered later."
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="14">
                        <TextBlock x:Name="NewKeyText" FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="CopyKeyBtn" Content="Copy Key" Style="{StaticResource SuccessButton}"
                                Padding="20,9" Click="OnCopyKeyClick" />
                        <Button Content="Done" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Padding="20,9" Click="OnCloseOverlayClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Keys grid ═══ -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="6">
            <DataGrid x:Name="KeysGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="{StaticResource SurfaceBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2736"
                      EnableRowVirtualization="True" FontSize="12.5"
                      ColumnHeaderHeight="34" RowHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="160" />
                    <DataGridTextColumn Header="Key Hash" Binding="{Binding HashShort}"
                                        Width="120" FontFamily="{StaticResource MonoFontFamily}" />
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="ACTIVE">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </Trigger>
                                                <Trigger Property="Text" Value="REVOKED">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </Trigger>
                                                <Trigger Property="Text" Value="UNUSED">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceShort}"
                                        Width="90" FontFamily="{StaticResource MonoFontFamily}" />
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="130" />
                    <DataGridTextColumn Header="Activated" Binding="{Binding ActivatedText}" Width="130" />
                    <DataGridTemplateColumn Header="Actions" Width="290">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Copy Key" Tag="{Binding KeyHash}"
                                            Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4"
                                            Click="OnCopyRowKeyClick" Margin="0,0,5,0"
                                            Visibility="{Binding HasLocalPlain, Converter={StaticResource BoolToVis}}" />
                                    <Button x:Name="RevokeBtn" Content="Revoke" Tag="{Binding KeyHash}"
                                            Style="{StaticResource DangerButton}" FontSize="11" Padding="10,4"
                                            Click="OnRevokeClick" Margin="0,0,5,0" />
                                    <Button x:Name="UnrevokeBtn" Content="Restore" Tag="{Binding KeyHash}"
                                            Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4"
                                            Click="OnUnrevokeClick" Margin="0,0,5,0" />
                                    <Button x:Name="ResetDevBtn" Content="Reset Device" Tag="{Binding KeyHash}"
                                            Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4"
                                            Click="OnResetDeviceClick" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="8,0,0,6" />
                        <Setter Property="BorderBrush" Value="#1F2736" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>

        <!-- ═══ Status bar ═══ -->
        <TextBlock x:Name="StatusBar" Grid.Row="3" Margin="4,10,0,0"
                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Not connected." TextWrapping="Wrap" />
    </Grid>
</Window>
