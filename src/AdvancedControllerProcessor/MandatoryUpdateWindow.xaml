<Window x:Class="AdvancedControllerProcessor.MandatoryUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Controller Processor — Update Required"
        Icon="Resources/BlankRL.ico"
        Width="560"
        SizeToContent="Height"
        MaxWidth="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="18" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="13">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F59E0B" Offset="0" />
                            <GradientStop Color="#F43F5E" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Update Required" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Your installed version is outdated and can no longer be used. Please update to continue."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" MaxWidth="400" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Version card ═══ -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="#1F2736" BorderThickness="1"
                CornerRadius="9" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="INSTALLED VERSION" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,0,0,3" />
                        <TextBlock x:Name="InstalledText" Text="v—"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="REQUIRED VERSION" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,3" />
                        <TextBlock x:Name="RequiredText" Text="v—"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="Collapsed" />

                <!-- Download progress -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,10,0,2">
                    <ProgressBar x:Name="UpdateProgress" Height="6" IsIndeterminate="True"
                                 Background="{StaticResource BorderBrush}"
                                 Foreground="{StaticResource AccentGradientBrush}"
                                 BorderThickness="0" />
                    <TextBlock x:Name="ProgressText" Text="Preparing…" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Footer ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="© Blank RL — Advanced Controller Processor"
                       FontSize="10.5" VerticalAlignment="Center"
                       Foreground="#525D70" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ExitBtn" Content="Exit"
                        Style="{StaticResource SecondaryButton}" FontSize="12.5" Padding="16,8"
                        Click="OnExitClick" Margin="0,0,8,0" />
                <Button x:Name="DownloadPageBtn" Content="Open Download Page"
                        Style="{StaticResource SecondaryButton}" FontSize="12.5" Padding="16,8"
                        Click="OnDownloadPageClick" Margin="0,0,8,0" />
                <Button x:Name="UpdateNowBtn" Content="Update Now"
                        Style="{StaticResource PrimaryButton}" FontSize="12.5" Padding="18,8"
                        Click="OnUpdateNowClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
