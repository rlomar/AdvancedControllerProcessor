<Window x:Class="AdvancedControllerProcessor.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DualSense Overlay — In-App Preview"
        Width="480" Height="330"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        MouseLeftButtonDown="OnDrag">
    <Border CornerRadius="18" Margin="6"
            Background="#F20C1120"
            BorderBrush="{StaticResource BorderGlowBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270"
                              Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="18,18,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Resources/BlankRL.ico" Width="22" Height="22"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="DUALSENSE OVERLAY" FontSize="12" FontWeight="Bold" Margin="8,0,0,0"
                                   Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatusChip}" Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="IN-APP ONLY" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}" />
                    </Border>
                    <Button Grid.Column="2" Content="✕" Width="26" Height="26" Padding="0"
                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                            Click="OnCloseClick" ToolTip="Close overlay" />
                </Grid>
            </Border>

            <!-- DualSense-shaped reference -->
            <Grid Grid.Row="1">
                <Viewbox Stretch="Uniform" Margin="18,6,18,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="340" Height="170">

                        <!-- Soft glow under the pad -->
                        <Ellipse Canvas.Left="60" Canvas.Top="55" Width="220" Height="100"
                                 Fill="{StaticResource AccentSoftBrush}" Opacity="0.55" />

                        <!-- Grips -->
                        <Ellipse Canvas.Left="12" Canvas.Top="38" Width="78" Height="122"
                                 Fill="{StaticResource SurfaceHoverBrush}" />
                        <Ellipse Canvas.Left="250" Canvas.Top="38" Width="78" Height="122"
                                 Fill="{StaticResource SurfaceHoverBrush}" />

                        <!-- Body -->
                        <Rectangle Canvas.Left="42" Canvas.Top="30" Width="256" Height="92" RadiusX="38" RadiusY="38">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2A3550" Offset="0" />
                                    <GradientStop Color="#1B2438" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Canvas.Left="42" Canvas.Top="30" Width="256" Height="92" RadiusX="38" RadiusY="38"
                                   Stroke="{StaticResource BorderGlowBrush}" StrokeThickness="1" />

                        <!-- Shoulder triggers (L1/L2 & R1/R2) -->
                        <Rectangle Canvas.Left="22" Canvas.Top="14" Width="46" Height="10" RadiusX="5" RadiusY="5"
                                   Fill="#2E3757" Stroke="#4C5A80" StrokeThickness="1" />
                        <TextBlock Canvas.Left="37" Canvas.Top="16.5" Text="L2" FontSize="7" FontWeight="Bold"
                                   Foreground="#98A2B8" />
                        <Rectangle Canvas.Left="24" Canvas.Top="26" Width="42" Height="11" RadiusX="5.5" RadiusY="5.5"
                                   Fill="#394662" Stroke="#4C5A80" StrokeThickness="1" />
                        <TextBlock Canvas.Left="36" Canvas.Top="28" Text="L1" FontSize="7" FontWeight="Bold"
                                   Foreground="#BFD0F0" />
                        <Rectangle Canvas.Left="272" Canvas.Top="14" Width="46" Height="10" RadiusX="5" RadiusY="5"
                                   Fill="#2E3757" Stroke="#4C5A80" StrokeThickness="1" />
                        <TextBlock Canvas.Left="287" Canvas.Top="16.5" Text="R2" FontSize="7" FontWeight="Bold"
                                   Foreground="#98A2B8" />
                        <Rectangle Canvas.Left="274" Canvas.Top="26" Width="42" Height="11" RadiusX="5.5" RadiusY="5.5"
                                   Fill="#394662" Stroke="#4C5A80" StrokeThickness="1" />
                        <TextBlock Canvas.Left="286" Canvas.Top="28" Text="R1" FontSize="7" FontWeight="Bold"
                                   Foreground="#BFD0F0" />

                        <!-- Light bar -->
                        <Border Canvas.Left="178" Canvas.Top="26" Width="34" Height="5" CornerRadius="2.5"
                                Background="{StaticResource BoostBlueBrush}" />

                        <!-- Touchpad -->
                        <Rectangle Canvas.Left="100" Canvas.Top="42" Width="140" Height="30" RadiusX="12" RadiusY="12"
                                   Fill="#3A4768" Stroke="#4C5A80" StrokeThickness="1" />

                        <!-- Left stick -->
                        <Ellipse Canvas.Left="76" Canvas.Top="36" Width="36" Height="36"
                                 Fill="#46577F" />
                        <Ellipse Canvas.Left="84" Canvas.Top="44" Width="20" Height="20"
                                 Fill="#7E8FB5" />
                        <Ellipse Canvas.Left="90" Canvas.Top="50" Width="8" Height="8"
                                 Fill="#223048" />

                        <!-- Right stick -->
                        <Ellipse Canvas.Left="228" Canvas.Top="92" Width="36" Height="36"
                                 Fill="#46577F" />
                        <Ellipse Canvas.Left="236" Canvas.Top="100" Width="20" Height="20"
                                 Fill="#7E8FB5" />
                        <Ellipse Canvas.Left="242" Canvas.Top="106" Width="8" Height="8"
                                 Fill="#223048" />

                        <!-- D-pad -->
                        <Rectangle Canvas.Left="66" Canvas.Top="92" Width="18" Height="48" RadiusX="4" RadiusY="4"
                                   Fill="#394662" />
                        <Rectangle Canvas.Left="48" Canvas.Top="110" Width="54" Height="18" RadiusX="4" RadiusY="4"
                                   Fill="#394662" />
                        <Ellipse Canvas.Left="79" Canvas.Top="109" Width="10" Height="10" Fill="#223048" />

                        <!-- Action buttons (PlayStation layout) -->
                        <!-- Triangle (top) -->
                        <Ellipse Canvas.Left="242" Canvas.Top="24" Width="22" Height="22" Fill="#394662" />
                        <TextBlock Canvas.Left="245.5" Canvas.Top="27" Text="△" FontSize="13" FontWeight="Bold"
                                   Foreground="#4CD964" />
                        <!-- Square (left) -->
                        <Ellipse Canvas.Left="224" Canvas.Top="44" Width="22" Height="22" Fill="#394662" />
                        <TextBlock Canvas.Left="228" Canvas.Top="47" Text="□" FontSize="13" FontWeight="Bold"
                                   Foreground="#FF93C4" />
                        <!-- Circle (right) -->
                        <Ellipse Canvas.Left="260" Canvas.Top="44" Width="22" Height="22" Fill="#394662" />
                        <TextBlock Canvas.Left="264.5" Canvas.Top="47" Text="○" FontSize="13" FontWeight="Bold"
                                   Foreground="#FF5A5A" />
                        <!-- Cross (bottom) -->
                        <Ellipse Canvas.Left="242" Canvas.Top="64" Width="22" Height="22" Fill="#394662" />
                        <TextBlock Canvas.Left="247" Canvas.Top="67" Text="×" FontSize="13" FontWeight="Bold"
                                   Foreground="#4FA8FF" />

                        <!-- Sticky labels -->
                        <TextBlock Canvas.Left="52" Canvas.Top="60" Text="L3" FontSize="8" FontWeight="Bold"
                                   Foreground="#98A2B8" />
                        <TextBlock Canvas.Left="272" Canvas.Top="60" Text="R3" FontSize="8" FontWeight="Bold"
                                   Foreground="#98A2B8" />

                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0,0,18,18" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DualSense controller reference — shown in this app only, never injected into or over a game."
                               FontSize="10" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="Layout: official DualSense" FontSize="9"
                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="12,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>