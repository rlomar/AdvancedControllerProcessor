<Window x:Class="AdvancedControllerProcessor.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Controller Processor — Activation"
        Icon="Resources/BlankRL.ico"
        Width="560"
        SizeToContent="Height"
        MaxWidth="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="18" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="13">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8B5CF6" Offset="0" />
                            <GradientStop Color="#C026D3" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Activation Required" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="This program requires a license key. Enter the key you received from Blank RL to activate this device."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" MaxWidth="400" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Key card ═══ -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="#1F2736" BorderThickness="1"
                CornerRadius="9" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <!-- Device ID row (informational) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="THIS DEVICE ID" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <TextBlock x:Name="DeviceIdText" FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Button x:Name="CopyDeviceBtn" Grid.Column="1" Content="Copy"
                            Style="{StaticResource SecondaryButton}" FontSize="11.5" Padding="14,5"
                            VerticalAlignment="Center" Click="OnCopyDeviceClick" />
                </Grid>

                <!-- Key input -->
                <TextBlock Text="LICENSE KEY" FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,5" />
                <TextBox x:Name="KeyInput" Style="{StaticResource NumericTextBox}"
                         FontSize="17" Padding="12,9" HorizontalContentAlignment="Center"
                         CharacterCasing="Upper" MaxLength="24"
                         TextChanged="OnKeyTextChanged" KeyDown="OnKeyDownHandler" />

                <!-- Status line -->
                <TextBlock x:Name="StatusText" FontSize="12.5" Margin="0,8,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <!-- Progress -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,10,0,2">
                    <ProgressBar x:Name="ActivateProgress" Height="6" IsIndeterminate="True"
                                 Background="{StaticResource BorderBrush}"
                                 Foreground="{StaticResource AccentGradientBrush}"
                                 BorderThickness="0" />
                    <TextBlock Text="Contacting activation server…" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Footer ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="© Blank RL — Advanced Controller Processor"
                       FontSize="10.5" VerticalAlignment="Center"
                       Foreground="#525D70" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ExitBtn" Content="Exit"
                        Style="{StaticResource SecondaryButton}" FontSize="12.5" Padding="16,8"
                        Click="OnExitClick" Margin="0,0,8,0" />
                <Button x:Name="ActivateBtn" Content="Activate"
                        Style="{StaticResource PrimaryButton}" FontSize="12.5" Padding="22,8"
                        Click="OnActivateClick" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
