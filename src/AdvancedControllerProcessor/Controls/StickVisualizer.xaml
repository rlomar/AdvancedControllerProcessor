<UserControl x:Class="AdvancedControllerProcessor.Controls.StickVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AdvancedControllerProcessor.Converters"
             Width="200" Height="200">

    <UserControl.Resources>
        <conv:FloatToStringConverter x:Key="FloatStr" />
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Stick Canvas -->
            <Canvas x:Name="StickCanvas"
                    Background="Transparent"
                    ClipToBounds="True">

                <!-- Crosshair lines -->
                <Line X1="100" Y1="0" X2="100" Y2="200"
                      Stroke="{StaticResource BorderBrush}" StrokeThickness="0.75"
                      StrokeDashArray="3,4" Canvas.Left="0" Canvas.Top="0" />
                <Line X1="0" Y1="100" X2="200" Y2="100"
                      Stroke="{StaticResource BorderBrush}" StrokeThickness="0.75"
                      StrokeDashArray="3,4" Canvas.Left="0" Canvas.Top="0" />

                <!-- Diagonal guides -->
                <Line X1="29" Y1="29" X2="171" Y2="171"
                      Stroke="#141F2736" StrokeThickness="0.75" />
                <Line X1="171" Y1="29" X2="29" Y2="171"
                      Stroke="#141F2736" StrokeThickness="0.75" />

                <!-- Concentric rings -->
                <Ellipse Width="66" Height="66" Fill="Transparent"
                         Stroke="#2237415A" StrokeThickness="1"
                         Canvas.Left="67" Canvas.Top="67" />
                <Ellipse Width="132" Height="132" Fill="Transparent"
                         Stroke="#2237415A" StrokeThickness="1"
                         Canvas.Left="34" Canvas.Top="34" />

                <!-- Deadzone circle (radius = deadzone * 100) -->
                <Ellipse x:Name="DeadzoneCircle"
                         Width="6" Height="6"
                         Fill="#268B5CF6"
                         Stroke="#668B5CF6"
                         StrokeThickness="1.25"
                         Canvas.Left="97" Canvas.Top="97" />

                <!-- Outer boundary circle -->
                <Ellipse Width="196" Height="196"
                         Fill="Transparent"
                         Stroke="{StaticResource BorderBrush}"
                         StrokeThickness="1.25"
                         Canvas.Left="2" Canvas.Top="2" />

                <!-- Raw position (hollow circle) -->
                <Ellipse x:Name="RawDot"
                         Width="10" Height="10"
                         Fill="Transparent"
                         Stroke="#808A94A7"
                         StrokeThickness="1.75"
                         Canvas.Left="95" Canvas.Top="95" />

                <!-- Processed position (glowing gradient dot) -->
                <Ellipse x:Name="ProcessedDot"
                         Width="14" Height="14"
                         Canvas.Left="93" Canvas.Top="93">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#A78BFA" Offset="0" />
                            <GradientStop Color="#C026D3" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0"
                                          Opacity="0.85" Color="#8B5CF6" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <!-- Labels -->
            <Grid Grid.Row="1" Margin="2,4,2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                        CornerRadius="6" Padding="7,3" Margin="0,0,2,0"
                        HorizontalAlignment="Stretch">
                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="10">
                        <Run Text="RAW " Foreground="#5A6478" />
                        <Run x:Name="RawText" Text="0.00, 0.00" Foreground="{StaticResource TextSecondaryBrush}" />
                    </TextBlock>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource CardBrush}"
                        CornerRadius="6" Padding="7,3" Margin="2,0,0,0"
                        HorizontalAlignment="Stretch">
                    <TextBlock TextAlignment="Right" FontFamily="{StaticResource MonoFontFamily}" FontSize="10">
                        <Run Text="OUT " Foreground="#5A6478" />
                        <Run x:Name="ProcessedText" Text="0.00, 0.00" Foreground="{StaticResource AccentHoverBrush}" />
                    </TextBlock>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
