<Window x:Class="AdvancedControllerProcessor.RequirementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:AdvancedControllerProcessor.Services"
        Title="Advanced Controller Processor — Setup Required"
        Width="580"
        SizeToContent="Height"
        MaxWidth="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Requirement card template -->
        <DataTemplate DataType="{x:Type services:RequirementStatus}">
            <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status icon -->
                    <Border x:Name="IconBadge" Grid.Column="0" Width="36" Height="36"
                            CornerRadius="10" Background="#26F43F5E"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="IconGlyph" Text="&#xE10A;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Info -->
                    <StackPanel Grid.Column="1" Margin="13,0,10,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border x:Name="OptionalBadgeHost" Background="#26F59E0B" CornerRadius="5"
                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding InstallHint}" FontSize="11" TextWrapping="Wrap"
                                   FontStyle="Italic" Margin="0,4,0,0"
                                   Foreground="#6B7689" />
                    </StackPanel>

                    <!-- Download button -->
                    <Button x:Name="DownloadBtn" Grid.Column="2" Content="Download"
                            Style="{StaticResource PrimaryButton}" FontSize="12" Padding="14,7"
                            VerticalAlignment="Center"
                            Click="OnDownloadClick" Tag="{Binding DownloadUrl}" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Mandatory}" Value="False">
                    <Setter TargetName="OptionalBadgeHost" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Installed}" Value="True">
                    <Setter TargetName="IconBadge" Property="Background" Value="#2610B981" />
                    <Setter TargetName="IconGlyph" Property="Text" Value="&#xE73E;" />
                    <Setter TargetName="IconGlyph" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="DownloadBtn" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="18" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="13">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F59E0B" Offset="0" />
                            <GradientStop Color="#F43F5E" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Setup Required" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="The program cannot start until the required components below are installed."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" MaxWidth="420" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Requirements list ═══ -->
        <ItemsControl Grid.Row="1" x:Name="RequirementsList" />

        <!-- ═══ Footer ═══ -->
        <Border Grid.Row="2" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Checking…" FontSize="12.5"
                               Foreground="{StaticResource WarningBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="© Blank RL — Advanced Controller Processor"
                               FontSize="10.5" Margin="0,4,0,0"
                               Foreground="#525D70" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RecheckBtn" Content="Re-check"
                            Style="{StaticResource SecondaryButton}" FontSize="12.5" Padding="16,8"
                            Click="OnRecheckClick" Margin="0,0,8,0" />
                    <Button x:Name="ExitBtn" Content="Exit Program"
                            Style="{StaticResource DangerButton}" FontSize="12.5" Padding="16,8"
                            Click="OnExitClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
