                                    Visibility="Collapsed" Cursor="Hand"
                                    ToolTip="Opens the download page"
                                    MouseLeftButtonUp="OnUpdateBannerClick">
                                <TextBlock x:Name="UpdateBannerText" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentHoverBrush}" />
                            </Border>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="© 2026 Blank RL — All rights reserved." Foreground="#55617A"
                                       FontSize="10.5" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Processing: OFF" x:Name="ToggleProcessingBtn"
                                    Style="{StaticResource PrimaryButton}" FontSize="11.5" Padding="14,7"
                                    Click="OnToggleProcessingClick" />
                            <Button Content="Safe Mode" x:Name="SafeModeBtn"
                                    Style="{StaticResource DangerButton}" FontSize="11.5" Padding="14,7"
                                    Click="OnSafeModeClick" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>