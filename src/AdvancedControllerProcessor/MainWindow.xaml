                        <!-- ══════════ TURBO ══════════ -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                                <StackPanel>
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Turbo — Rapid-Fire Buttons" Style="{StaticResource SubHeaderText}" Margin="0,0,0,6" />
                                            <TextBlock Text="Real functionality, not a visual effect. While a turbo button is held, the virtual controller re-presses it at the rate below — exactly like classic rapid-fire controllers. Works only while Processing is ON (F8)."
                                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />

                                            <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <CheckBox Content="Enable Turbo (master switch)"
                                                              Style="{StaticResource ModernCheckBox}"
                                                              IsChecked="{Binding Turbo.TurboEnabled}" Margin="0,0,0,12" />
                                                    <TextBlock Text="Gap between presses (ms)" Style="{StaticResource LabelStyle}" />
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Grid.Column="0" Style="{StaticResource ModernSlider}"
                                                                Minimum="0.01" Maximum="200" TickFrequency="1"
                                                                IsSnapToTickEnabled="False"
                                                                Value="{Binding Turbo.TurboIntervalMs}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBox Style="{StaticResource NumericTextBox}" Width="58"
                                                                     Text="{Binding Turbo.TurboIntervalMs, Converter={StaticResource FloatStr}, ConverterParameter=F3, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextAlignment="Center" />
                                                            <TextBlock Text="ms" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                       Style="{StaticResource LabelStyle}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Turbo.IntervalText}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentHoverBrush}" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" IsEnabled="{Binding Turbo.TurboEnabled}">
                                        <StackPanel>
                                            <TextBlock Text="Assign Turbo Buttons" Style="{StaticResource SubHeaderText}" Margin="0,0,0,12" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>

                                                <CheckBox Grid.Column="0" Grid.Row="0" Content="A  (Cross)" Margin="0,0,6,10"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          IsChecked="{Binding Turbo.TurboA}" />
                                                <CheckBox Grid.Column="1" Grid.Row="0" Content="B  (Circle)" Margin="0,0,6,10"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          IsChecked="{Binding Turbo.TurboB}" />
                                                <CheckBox Grid.Column="2" Grid.Row="0" Content="X  (Square)" Margin="0,0,6,10"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          IsChecked="{Binding Turbo.TurboX}" />

                                                <CheckBox Grid.Column="0" Grid.Row="1" Content="Y  (Triangle)" Margin="0,0,6,10"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          IsChecked="{Binding Turbo.TurboY}" />
                                                <CheckBox Grid.Column="1" Grid.Row="1" Content="LB  (L1)" Margin="0,0,6,10"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          IsChecked="{Binding Turbo.TurboLB}" />
                                                <CheckBox Grid.Column="2" Grid.Row="1" Content="RB  (R1)" Margin="0,0,6,10"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          IsChecked="{Binding Turbo.TurboRB}" />
                                            </Grid>
                                            <TextBlock Text="D-Pad, triggers and analogue sticks are never turbo'd — raw input always reaches the virtual pad for them."
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Rapid-fire notes" Style="{StaticResource SubHeaderText}" Margin="0,0,0,8" />
                                            <TextBlock Text="· First press answers with ZERO delay — the instant you hold, the press is sent (0 ms).&#10;· The gap between flips can go as low as 0.01 ms; the engine floors it at ~1 ms because the virtual pad reports at 250 Hz max — any value below that is converted to the pad's real ceiling (≈500 presses/s).&#10;· A gap cannot be literally 0: a held button must drop between presses or the game sees one long hold.&#10;· In Rocket League, avoid turbo on Boost (usually X/Square) or Jump (usually A/Cross) unless you intend it — a rapid input there can feel like extra presses."
                                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ══════════ PROFILES ══════════ -->
