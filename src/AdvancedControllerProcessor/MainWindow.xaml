<Window x:Class="AdvancedControllerProcessor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:AdvancedControllerProcessor.Controls"
        xmlns:conv="clr-namespace:AdvancedControllerProcessor.Converters"
        xmlns:models="clr-namespace:AdvancedControllerProcessor.Models"
        Title="Advanced Controller Processor — Blank RL"
        Icon="Resources/BlankRL.ico"
        Width="1120" Height="740"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToStatusConverter x:Key="BoolToStatus" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:FloatToStringConverter x:Key="FloatStr" />
    </Window.Resources>

    <Grid>
        <!-- ══ Ambient aurora backdrop ══ -->
        <Canvas IsHitTestVisible="False" Opacity="0.55">
            <Ellipse Width="520" Height="520" Canvas.Left="-120" Canvas.Top="-180"
                     Fill="{StaticResource AuroraViolet}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="GlowViolet" X="0" Y="0" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="460" Height="460" Canvas.Right="-110" Canvas.Bottom="-190"
                     Fill="{StaticResource AuroraCyan}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="GlowCyan" X="0" Y="0" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <Grid Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══ SIDEBAR ══ -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderGlowBrush}" BorderThickness="1"
                    CornerRadius="18" Margin="0,0,12,0" Padding="12,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270"
                                      Opacity="0.3" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,16">
                        <Image Source="Resources/BlankRL.ico" Width="40" Height="40"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BLANK RL" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="CONTROLLER PROCESSOR" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="SideNav" Checked="OnNavChecked"
                                     Tag="0" Content="Dashboard" IsChecked="True" />
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="SideNav" Checked="OnNavChecked"
                                     Tag="1" Content="Left Stick" />
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="SideNav" Checked="OnNavChecked"
                                     Tag="2" Content="Right Stick" />
                        <Border Background="#233755" CornerRadius="10" Margin="6,14,6,8" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="⚡ RAPID-FIRE" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}" />
                                <TextBlock Text="Turbo buttons now live. Hold a turbo button — it re-presses itself as fast as the pad allows (gap down to 0.01 ms), first press instant."
                                           TextWrapping="Wrap" FontSize="10.5" Margin="0,3,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="SideNav" Checked="OnNavChecked"
                                     Tag="3" Content="Turbo" />
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="SideNav" Checked="OnNavChecked"
                                     Tag="4" Content="Profiles" />
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="SideNav" Checked="OnNavChecked"
                                     Tag="5" Content="Advanced" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="6,10,6,0">
                        <Border Style="{StaticResource StatusChip}" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="HOTKEYS" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="F8 — Toggle processing · F9 — Safe mode"
                                           FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="v1.6.5  ·  © 2026 Blank RL" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                   Foreground="#5A6578" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ MAIN COLUMN ══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ══ ROCKET LEAGUE HERO BANNER ══ -->
                <Border Grid.Row="0" Height="150" CornerRadius="18" ClipToBounds="True"
                        BorderBrush="{StaticResource BorderGlowBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="7" Direction="270"
                                          Opacity="0.4" Color="#000000" />
                    </Border.Effect>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="ShineShift"
                                                     Storyboard.TargetProperty="X"
                                                     From="-320" To="1200" Duration="0:0:8" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid>
                        <Image Source="Resources/RocketLeagueHero.jpg" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border Background="{StaticResource HeroShadeBrush}" />
                        <Border Background="{StaticResource HeroVignetteBrush}" />

                        <!-- Moving sheen -->
                        <Border x:Name="ShineRect" Width="220" Background="White" Opacity="0.07"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ShineShift" X="-260" />
                            </Border.RenderTransform>
                        </Border>

                        <Grid Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="ROCKET LEAGUE READY" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}" />
                                <TextBlock Text="Advanced Controller Processor"
                                           Style="{StaticResource HeaderText}" Margin="0,3,0,0"
                                           FontSize="24" />
                                <TextBlock Text="DualSense → virtual Xbox 360 / DualShock 4 pipeline, tuned for high-speed play."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Border Style="{StaticResource StatusChip}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                                 Fill="{Binding Controller.PhysicalStatusColor}" />
                                        <TextBlock Text="{Binding Controller.ControllerName}" FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text=" ·  " FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Controller.ConnectionTypeText}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusChip}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                                 Fill="{Binding IsProcessingEnabled, Converter={StaticResource BoolToStatus}, ConverterParameter=color}" />
                                        <TextBlock Text="Processing: " FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding IsProcessingEnabled, Converter={StaticResource BoolToStatus}, ConverterParameter=text}"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusChip}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource CyanBrush}" />
                                        <TextBlock Text="Rate: " FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding MeasuredRateText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                                 Fill="{Binding Turbo.TurboEnabled, Converter={StaticResource BoolToStatus}, ConverterParameter=color}" />
                                        <TextBlock Text="Turbo: " FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Turbo.EnabledText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ══ TAB HOST ══ -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderGlowBrush}" BorderThickness="1"
                        CornerRadius="18" Padding="14" Margin="0,12,0,0">
                    <TabControl x:Name="ScrollingTabHost" Style="{StaticResource ModernTabControl}"
                                ItemContainerStyle="{StaticResource ModernTabItem}">

                        <!-- ══════════ DASHBOARD ══════════ -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Controller -->
                                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <TextBlock Text="Controller" Style="{StaticResource SubHeaderText}" Margin="0,0,0,12" />
                                                <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Controller.PhysicalStatusIcon}"
                                                                   Foreground="{Binding Controller.PhysicalStatusColor}"
                                                                   FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Controller.ControllerName}"
                                                                       FontWeight="SemiBold" FontSize="14" />
                                                            <TextBlock Text="{Binding Controller.StatusText}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InnerPanel}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Controller.VirtualStatusIcon}"
                                                                   Foreground="{Binding Controller.VirtualStatusColor}"
                                                                   FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Virtual Controller" FontWeight="SemiBold" FontSize="14" />
                                                            <TextBlock Text="{Binding VirtualTypeName}" FontSize="12"
                                                                       Foreground="{StaticResource AccentHoverBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Processing + Rate -->
                                        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <TextBlock Text="Processing" Style="{StaticResource SubHeaderText}" Margin="0,0,0,12" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="State" Style="{StaticResource LabelStyle}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                     Fill="{Binding IsProcessingEnabled, Converter={StaticResource BoolToStatus}, ConverterParameter=color}" />
                                                            <TextBlock Text="{Binding IsProcessingEnabled, Converter={StaticResource BoolToStatus}, ConverterParameter=text}"
                                                                       FontSize="17" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Profile" Style="{StaticResource LabelStyle}" />
                                                        <TextBlock Text="{Binding SelectedProfileName}" FontSize="17" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Live Report Rate" Style="{StaticResource LabelStyle}" />
                                                            <TextBlock Text="real submissions / second" FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding MeasuredRateText}"
                                                                   Style="{StaticResource MetricValueStyle}"
                                                                   Foreground="{StaticResource AccentHoverBrush}"
                                                                   HorizontalAlignment="Right" Margin="12,0,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <Button Content="Processing: OFF"
                                                        Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                                                        Click="OnToggleProcessingClick" />
                                                <Button Content="Safe Mode (F9)"
                                                        Style="{StaticResource DangerButton}"
                                                        Click="OnSafeModeClick" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Input Latency + Live Monitor -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <TextBlock Text="Input Latency" Style="{StaticResource SubHeaderText}" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                                 Fill="{Binding LatencyHealthBrush}" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding LatencyHealthText}" FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="PIPELINE (process + submit)" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,6" />
                                                    <UniformGrid Columns="3">
                                                        <StackPanel>
                                                            <TextBlock Text="avg" Style="{StaticResource LabelStyle}" />
                                                            <TextBlock Text="{Binding PipelineAvgText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="max" Style="{StaticResource LabelStyle}" />
                                                            <TextBlock Text="{Binding PipelineMaxText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="p95" Style="{StaticResource LabelStyle}" />
                                                            <TextBlock Text="{Binding PipelineP95Text}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                </StackPanel>
                                                <StackPanel Margin="0,12,0,0">
                                                    <TextBlock Text="SCHEDULING WAIT" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,6" />
                                                    <UniformGrid Columns="3">
                                                        <StackPanel>
                                                            <TextBlock Text="avg" Style="{StaticResource LabelStyle}" />
                                                            <TextBlock Text="{Binding WaitAvgText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="max" Style="{StaticResource LabelStyle}" />
                                                            <TextBlock Text="{Binding WaitMaxText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="p95" Style="{StaticResource LabelStyle}" />
                                                            <TextBlock Text="{Binding WaitP95Text}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <TextBlock Text="{Binding WaitModeText}" FontSize="10.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <TextBlock Text="Live Input Monitor" Style="{StaticResource SubHeaderText}" Margin="0,0,0,12" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                        <TextBlock Text="LEFT STICK" Style="{StaticResource LabelStyle}"
                                                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                                                        <ctrl:StickVisualizer x:Name="LeftStickVisualizer" Width="150" Height="150"
                                                                              HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                        <TextBlock Text="RIGHT STICK" Style="{StaticResource LabelStyle}"
                                                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                                                        <ctrl:StickVisualizer x:Name="RightStickVisualizer" Width="150" Height="150"
                                                                              HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Rocket League + Turbo Quick -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <TextBlock Text="Rocket League" Style="{StaticResource SubHeaderText}" />
                                                    <Border Background="#233755" CornerRadius="6" Padding="8,3"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="OFFICIAL" FontSize="9.5" FontWeight="Bold"
                                                                   Foreground="{StaticResource CyanBrush}" />
                                                    </Border>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True"
                                                            Width="104" Height="60">
                                                        <Image Source="Resources/RocketLeagueCapsule.jpg" Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="DualSense controller overlay" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="Controller-shaped reference inside this app only — never injected into the game."
                                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Button Content="Apply Rocket League Preset" Style="{StaticResource SecondaryButton}"
                                                        Margin="0,0,0,8" Click="OnApplyRocketLeaguePresetClick" />
                                                <Button Content="Configure Turbo..." Style="{StaticResource SecondaryButton}"
                                                        Click="OnOpenTurboClick" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <TextBlock Text="Turbo — Rapid-Fire" Style="{StaticResource SubHeaderText}" Margin="0,0,0,12" />
                                                <CheckBox Content="Enable Turbo (real re-press, instant first hit)"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          IsChecked="{Binding Turbo.TurboEnabled}" Margin="0,0,0,12" />
                                                <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Gap" Style="{StaticResource LabelStyle}" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding Turbo.IntervalText}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AccentHoverBrush}" />
                                                        </StackPanel>
                                                        <UniformGrid Columns="6" Margin="0,8,0,0">
                                                            <Border Style="{StaticResource StatusChip}" Margin="0,0,4,0">
                                                                <TextBlock Text="A" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{Binding Turbo.TurboA, Converter={StaticResource BoolToStatus}, ConverterParameter=text}"
                                                                           Background="Transparent" />
                                                            </Border>
                                                            <Border Style="{StaticResource StatusChip}" Margin="0,0,4,0">
                                                                <TextBlock Text="B" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{Binding Turbo.TurboB, Converter={StaticResource BoolToStatus}, ConverterParameter=text}" />
                                                            </Border>
                                                            <Border Style="{StaticResource StatusChip}" Margin="0,0,4,0">
                                                                <TextBlock Text="X" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{Binding Turbo.TurboX, Converter={StaticResource BoolToStatus}, ConverterParameter=text}" />
                                                            </Border>
                                                            <Border Style="{StaticResource StatusChip}" Margin="0,0,4,0">
                                                                <TextBlock Text="Y" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{Binding Turbo.TurboY, Converter={StaticResource BoolToStatus}, ConverterParameter=text}" />
                                                            </Border>
                                                            <Border Style="{StaticResource StatusChip}" Margin="0,0,4,0">
                                                                <TextBlock Text="LB" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{Binding Turbo.TurboLB, Converter={StaticResource BoolToStatus}, ConverterParameter=text}" />
                                                            </Border>
                                                            <Border Style="{StaticResource StatusChip}">
                                                                <TextBlock Text="RB" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{Binding Turbo.TurboRB, Converter={StaticResource BoolToStatus}, ConverterParameter=text}" />
                                                            </Border>
                                                        </UniformGrid>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="Assign turbo to A/B/X/Y punch, jump and shoulder buttons on the Turbo tab. Right stick and triggers stay untouched — camera control in Rocket League is preserved."
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Button Content="Configure Turbo →" Style="{StaticResource PrimaryButton}"
                                                        Click="OnOpenTurboClick" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ══════════ LEFT STICK ══════════ -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                                <StackPanel>
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Left Stick Processing" Style="{StaticResource SubHeaderText}" Margin="0,0,0,12" />
                                            <ctrl:StickVisualizer x:Name="LeftStickDetailVisualizer" Width="200" Height="200"
                                                                  HorizontalAlignment="Center" Margin="0,0,0,16" />

                                            <TextBlock Text="Deadzone" Style="{StaticResource LabelStyle}" Margin="0,8,0,4" />
                                            <CheckBox Content="Enable Deadzone"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding LeftStick.DeadzoneEnabled}" Margin="0,0,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0"
                                                        Style="{StaticResource ModernSlider}"
                                                        Minimum="0" Maximum="0.5" SmallChange="0.001" LargeChange="0.01"
                                                        Value="{Binding LeftStick.Deadzone}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         Style="{StaticResource NumericTextBox}"
                                                         Text="{Binding LeftStick.Deadzone, Converter={StaticResource FloatStr}, ConverterParameter=F3}"
                                                         TextAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>

                                            <TextBlock Text="Response Curve" Style="{StaticResource LabelStyle}" Margin="0,12,0,4" />
                                            <ComboBox Style="{StaticResource ModernComboBox}"
                                                      SelectedValue="{Binding LeftStick.ResponseCurve}"
                                                      SelectedValuePath="Content">
